{
  "name": "liveportfolio-bench",
  "private": true,
  "description": "Evaluation harnesses for the CV import pipeline. NOT a workspace: root `npm ci` (CI / VPS deploy) never installs this.",
  "scripts": {
    "synth:build": "tsx synthetic/build.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "bench:variants": "vitest run --config vitest.bench.config.ts variants.bench.ts",
    "bench:models": "vitest run --config vitest.bench.config.ts models.bench.ts",
    "bench:pii": "tsx pii-compare.ts",
    "synth:hard": "tsx synthetic/build-hard.ts",
    "bench:models-hard": "vitest run --config vitest.bench.config.ts models-hard.bench.ts",
    "study:pdf": "node pdf-study/run.cjs",
    "proposals": "tsx proposals-eval.ts",
    "probe:zipbomb": "node robustness-probe.cjs"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.7",
    "docx": "^9.14.0",
    "libphonenumber-js": "^1.12.0",
    "openredaction": "^1.1.5",
    "pdfjs-dist": "^6.4.299",
    "pdfkit": "^0.20.2",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "unpdf": "^1.0.0",
    "vitest": "^2.1.9"
  }
}
