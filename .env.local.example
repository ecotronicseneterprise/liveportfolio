NEXT_PUBLIC_ROOT_DOMAIN=liveportfolio.site
NEXT_PUBLIC_APP_URL=https://liveportfolio.site

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Paystack subscription plan codes — create in Paystack dashboard → Products → Plans
# Basic: $9/year recurring | Pro: $49/year recurring
# PAYSTACK_BASIC_PLAN_CODE is server-side only (webhook); NEXT_PUBLIC_ is for UpgradeModal
PAYSTACK_BASIC_PLAN_CODE=PLN_
PAYSTACK_PRO_PLAN_CODE=PLN_
NEXT_PUBLIC_PAYSTACK_BASIC_PLAN_CODE=PLN_
NEXT_PUBLIC_PAYSTACK_PRO_PLAN_CODE=PLN_

RESEND_API_KEY=

ADMIN_METRICS_SECRET=

CRON_SECRET=
# Random secret used to protect /api/cron/drip — generate with: openssl rand -hex 32

IPINFO_TOKEN=
# Free tier: 50,000 lookups/month — get at ipinfo.io

# ── Import connectors / PII gateway (see docs/import-connectors.md, docs/pii-gateway.md) ──
IMPORT_ENABLED=false
NEXT_PUBLIC_IMPORT_ENABLED=false
GITHUB_TOKEN=
IMPORT_DAILY_CALL_CAP=0
TRUSTED_IP_HEADER=
PII_ENGINE=regex
PII_ON_ENGINE_FAILURE=block
PII_SCORE_THRESHOLDS=
LLM_MODEL=gpt-4o-mini
# GPT-6 family only: none|low|medium|high|xhigh|max (default none). Ignored by other models.
LLM_REASONING_EFFORT=
# GitHub connector: optional one-sentence README summary for repos with no/short description (uses callLLM, PII redaction on)
GITHUB_README_SUMMARY=false
