NEXT_PUBLIC_ROOT_DOMAIN=liveportfolio.site
NEXT_PUBLIC_APP_URL=https://liveportfolio.site

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Paystack subscription plan codes — create in Paystack dashboard → Products → Plans
# Basic: $9/year recurring | Pro: $49/year recurring
# PAYSTACK_BASIC_PLAN_CODE is server-side only (webhook); NEXT_PUBLIC_ is for UpgradeModal
PAYSTACK_BASIC_PLAN_CODE=PLN_
PAYSTACK_PRO_PLAN_CODE=PLN_
NEXT_PUBLIC_PAYSTACK_BASIC_PLAN_CODE=PLN_
NEXT_PUBLIC_PAYSTACK_PRO_PLAN_CODE=PLN_

RESEND_API_KEY=

ADMIN_METRICS_SECRET=

CRON_SECRET=
# Random secret used to protect /api/cron/drip — generate with: openssl rand -hex 32

IPINFO_TOKEN=
# Free tier: 50,000 lookups/month — get at ipinfo.io

# ── Import connectors / PII gateway (see docs/import-connectors.md, docs/pii-gateway.md) ──
IMPORT_ENABLED=false
NEXT_PUBLIC_IMPORT_ENABLED=false
GITHUB_TOKEN=
IMPORT_DAILY_CALL_CAP=0
TRUSTED_IP_HEADER=
PII_ENGINE=regex
PII_ON_ENGINE_FAILURE=block
PII_SCORE_THRESHOLDS=
LLM_MODEL=gpt-4o-mini
# GPT-6 family only: none|low|medium|high|xhigh|max (default none). Ignored by other models.
LLM_REASONING_EFFORT=
# GitHub connector: optional one-sentence README summary for repos with no/short description (uses callLLM, PII redaction on)
GITHUB_README_SUMMARY=false

# ── New onboarding flow (dark by default; the old /create wizard stays the only path while false) ──
NEXT_PUBLIC_ONBOARDING_V2=false
# Cloudflare Turnstile site key (public). Leave empty until CAPTCHA protection is enforced in Supabase.
# WARNING: Supabase enforces the captcha on ALL password sign-in / sign-up / reset / resend calls at once, and the OLD
# wizard's signUp has no widget. Enforce it only when NEXT_PUBLIC_ONBOARDING_V2 is true and the old wizard is retired.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Social / passwordless sign-in buttons. Empty = none render. Values: google, github, linkedin_oidc, email_otp.
# Turn "Confirm email" ON in Supabase BEFORE listing any provider (docs/social-signin-setup.md).
NEXT_PUBLIC_SOCIAL_PROVIDERS=
# When true, /api/import and /api/parse-cv reject calls with no Bearer token (the old wizard sends none). Keep false until it is retired.
REQUIRE_AUTH_FOR_LLM=false

# ── Billing webhook ──
# Price check rollout switch. Unset/anything else = mismatches are only LOGGED and the payment is honoured.
# "enforce" = a payment whose currency+amount does not match the plan is rejected (money taken, nothing granted).
# Turn on only after the Paystack test-mode checklist (docs/unification-plan.md) passes.
PAYSTACK_PRICE_CHECK=
# Optional override of the expected prices, smallest currency unit: {"basic":[{"currency":"NGN","amount":1500000}],"pro":[{"currency":"NGN","amount":4500000}],"test":[{"currency":"NGN","amount":50000}]}
PAYSTACK_EXPECTED_PRICES=
